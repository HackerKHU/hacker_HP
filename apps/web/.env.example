# 이 파일을 .env.local로 복사해서 쓴다. .env.local은 커밋하지 않는다.
# API base URL은 코드에 /api/v1로 고정되어 있다 (Vercel rewrites 프록시). 환경변수로 바꾸지 않는다.

# 백엔드 없이 화면을 개발할 때만 true. 기본값은 꺼짐이며 배포 환경에서는 절대 켜지 않는다.
# 서버가 붙으면 src/api/fixtures.ts와 함께 이 항목도 지운다.
VITE_USE_FIXTURES=false

# VITE_USE_FIXTURES=true일 때 어떤 사용자·실패 상황으로 볼지 고른다. 기본값 user.
# user | admin | pending | guest | suspended | blocked
# 값의 의미는 src/api/fixtures.ts 주석에 있다.
VITE_FIXTURE_SCENARIO=user
