# 이 파일을 terraform.tfvars로 복사한 뒤 실제 값을 채운다.
# terraform.tfvars는 .gitignore 대상이다 — 절대 커밋하지 않는다.

google_client_id     = "xxxxxxxx.apps.googleusercontent.com"
google_client_secret = "GOCSPX-xxxxxxxx"
# 웹의 실제 오리진과 글자 하나까지 같아야 한다 — 원본은 apps/web/site.config.ts다.
# www를 빼면 S3 CORS가 presigned 업로드를 막고, 구글이 redirect_uri_mismatch로 거절한다.
oauth_redirect_uri    = "https://www.khuhacker.com/api/v1/login/oauth2/code/google"
vercel_origin         = "https://www.khuhacker.com"
admin_bootstrap_email = "admin@khu.ac.kr"
